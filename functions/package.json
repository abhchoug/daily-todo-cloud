{
  "name": "daily-todo-functions",
  "description": "Cloud Functions for Daily ToDo app",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --platform=node --format=esm",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "typescript": "^5.1.6",
    "@types/node": "^20.3.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3"
  }
}
